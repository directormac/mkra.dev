---
/**
 * VideoEmbed Component - Embed YouTube, Vimeo, or other video platforms
 *
 * Usage in markdown:
 * <VideoEmbed id="VIDEO_ID" platform="youtube" />
 * <VideoEmbed id="VIDEO_ID" platform="vimeo" title="My Video" />
 * <VideoEmbed url="https://www.youtube.com/watch?v=VIDEO_ID" />
 */

interface Props {
  /** YouTube/Vimeo video ID */
  id?: string;
  /** Full video URL (alternative to id + platform) */
  url?: string;
  /** Platform: youtube, vimeo, or generic iframe */
  platform?: "youtube" | "vimeo" | "iframe";
  /** Video title for accessibility */
  title?: string;
  /** Start time in seconds */
  start?: number;
  /** Enable privacy-enhanced mode (YouTube) */
  privacy?: boolean;
  /** Custom aspect ratio (default: 16/9) */
  aspectRatio?: string;
}

const {
  id,
  url,
  platform = "youtube",
  title = "Embedded video",
  start,
  privacy = true,
  aspectRatio = "16/9",
} = Astro.props;

// Extract video ID from various URL formats
function extractVideoId(inputUrl: string, plat: string): string | null {
  if (plat === "youtube") {
    const patterns = [
      /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\s?]+)/,
      /^([a-zA-Z0-9_-]{11})$/, // Direct ID
    ];
    for (const pattern of patterns) {
      const match = inputUrl.match(pattern);
      if (match) return match[1];
    }
  } else if (plat === "vimeo") {
    const patterns = [
      /vimeo\.com\/(\d+)/,
      /vimeo\.com\/video\/(\d+)/,
      /^(\d+)$/, // Direct ID
    ];
    for (const pattern of patterns) {
      const match = inputUrl.match(pattern);
      if (match) return match[1];
    }
  }
  return null;
}

// Determine platform from URL if not specified
function detectPlatform(inputUrl: string): "youtube" | "vimeo" | "iframe" {
  if (inputUrl.includes("youtube.com") || inputUrl.includes("youtu.be")) {
    return "youtube";
  }
  if (inputUrl.includes("vimeo.com")) {
    return "vimeo";
  }
  return "iframe";
}

// Build embed URL
let embedUrl: string | null = null;

if (url && !id) {
  // Extract info from URL
  const detectedPlatform = detectPlatform(url);
  const extractedId = extractVideoId(url, detectedPlatform);

  if (detectedPlatform === "youtube" && extractedId) {
    const baseUrl = privacy
      ? "https://www.youtube-nocookie.com/embed"
      : "https://www.youtube.com/embed";
    const params = new URLSearchParams();
    if (start) params.set("start", String(start));
    embedUrl = `${baseUrl}/${extractedId}${params.toString() ? "?" + params : ""}`;
  } else if (detectedPlatform === "vimeo" && extractedId) {
    const params = new URLSearchParams();
    if (start) params.set("t", String(start) + "s");
    embedUrl = `https://player.vimeo.com/video/${extractedId}${params.toString() ? "?" + params : ""}`;
  } else {
    // Generic iframe - use URL directly
    embedUrl = url;
  }
} else if (id) {
  // Use explicit ID and platform
  if (platform === "youtube") {
    const baseUrl = privacy
      ? "https://www.youtube-nocookie.com/embed"
      : "https://www.youtube.com/embed";
    const params = new URLSearchParams();
    if (start) params.set("start", String(start));
    embedUrl = `${baseUrl}/${id}${params.toString() ? "?" + params : ""}`;
  } else if (platform === "vimeo") {
    const params = new URLSearchParams();
    if (start) params.set("t", String(start) + "s");
    embedUrl = `https://player.vimeo.com/video/${id}${params.toString() ? "?" + params : ""}`;
  } else {
    embedUrl = id; // Treat as direct URL for iframe
  }
}

const aspectStyle = aspectRatio.includes("/")
  ? aspectRatio.replace("/", " / ")
  : aspectRatio;
---

{
  embedUrl ? (
    <figure class="video-embed not-prose my-6">
      <div
        class="video-container overflow-hidden rounded-xl border border-border/20 bg-foreground/5 shadow-sm"
        style={`aspect-ratio: ${aspectStyle};`}
      >
        <iframe
          src={embedUrl}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
          class="h-full w-full border-0"
        />
      </div>
      {title && title !== "Embedded video" && (
        <figcaption class="mt-2 text-center text-sm text-foreground/60">
          {title}
        </figcaption>
      )}
    </figure>
  ) : (
    <div class="video-embed-error not-prose my-6 rounded-xl border border-red-500/20 bg-red-500/5 p-4 text-sm text-red-500/80">
      <p class="font-medium">⚠️ Invalid video URL or ID</p>
      <p class="mt-1 opacity-80">
        Please provide a valid YouTube/Vimeo URL or video ID.
      </p>
    </div>
  )
}

<style>
  @reference "../styles/global.css";

  .video-container {
    position: relative;
    width: 100%;
  }

  .video-container iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Hover effect */
  .video-container:hover {
    border-color: color-mix(in oklab, var(--accent) 30%, var(--border));
    box-shadow: 0 0 20px color-mix(in oklab, var(--accent) 8%, transparent);
  }
</style>
