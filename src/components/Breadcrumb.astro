---
// Get the domain name from site config or URL
const domain = "mkra.dev";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Check if we're on the home page
const isHomePage = currentUrlPath === "" || currentUrlPath === "/";

// Get url array from path and filter empty strings
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

// Get parent URL for cd ..
let parentUrl = "/";
if (breadcrumbList.length > 0) {
  parentUrl = "/" + breadcrumbList.slice(0, -1).join("/");
  if (parentUrl !== "/") parentUrl += "/";
}
---

<nav class="app-layout mt-6 mb-2" aria-label="breadcrumb">
  <div
    class="breadcrumb-bar flex items-center justify-between gap-2 border border-border/20 bg-muted/5 px-2 py-1.5 font-cartograph text-xs backdrop-blur-sm sm:gap-4 sm:px-3 sm:text-sm"
  >
    {/* Left side - Path */}
    <div
      class="flex min-w-0 flex-1 items-center gap-1 overflow-hidden sm:gap-1.5"
    >
      {/* cd .. button - compact on mobile */}
      <a
        href={parentUrl}
        class="back-btn group inline-flex shrink-0 items-center justify-center gap-0.5 px-1 py-0.5 text-foreground/50 transition-all duration-200 hover:bg-muted/10 hover:text-accent sm:gap-1 sm:px-1.5"
        title="Go back"
      >
        <svg
          class="size-3 transition-transform duration-200 group-hover:-translate-x-0.5 sm:size-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span class="hidden sm:inline">cd ..</span>
      </a>

      <span class="breadcrumb-sep shrink-0 text-accent/40">/</span>

      {/* Home / Domain */}
      {
        isHomePage ? (
          <span
            class="breadcrumb-current truncate text-accent/90"
            aria-current="page"
          >
            {domain}
          </span>
        ) : (
          <a
            href="/"
            class="breadcrumb-link shrink-0 text-foreground/50 transition-colors duration-200 hover:text-accent"
            aria-label="Home"
          >
            <span class="sm:hidden">~</span>
            <span class="hidden sm:inline">{domain}</span>
          </a>
        )
      }

      {
        breadcrumbList.map((breadcrumb, index) => {
          // Skip page numbers in display
          if (!isNaN(Number(breadcrumb))) return null;

          const isLast =
            index === breadcrumbList.length - 1 ||
            (index === breadcrumbList.length - 2 &&
              !isNaN(Number(breadcrumbList[index + 1])));
          const displayText = decodeURIComponent(breadcrumb).replace(/-/g, " ");
          // First items get hidden on mobile (only show on sm+)
          const isFirstVisible = index === 0;

          return (
            <>
              <span
                class:list={[
                  "breadcrumb-sep shrink-0 text-accent/40",
                  { "hidden sm:inline": !isLast },
                ]}
              >
                /
              </span>

              {isLast ? (
                <span
                  class="breadcrumb-current truncate text-accent/90 capitalize"
                  aria-current="page"
                >
                  {displayText}
                </span>
              ) : (
                <a
                  href={`/${breadcrumbList.slice(0, index + 1).join("/")}/`}
                  class:list={[
                    "breadcrumb-link shrink-0 text-foreground/50 capitalize transition-colors duration-200 hover:text-accent",
                    { "hidden sm:inline": !isFirstVisible },
                  ]}
                >
                  {displayText}
                </a>
              )}
            </>
          );
        })
      }
    </div>

    {/* Right side - Status info */}
    <div class="flex shrink-0 items-center gap-2 text-xs md:gap-3">
      {/* Git branch - hidden on small/medium */}
      <span class="hidden items-center gap-1 text-foreground/50 md:inline-flex">
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="6" y1="3" x2="6" y2="15"></line>
          <circle cx="18" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <path d="M18 9a9 9 0 0 1-9 9"></path>
        </svg>
        <span>main</span>
      </span>

      {/* Package version - hidden on smaller screens */}
      <span class="hidden items-center gap-1 text-foreground/40 lg:inline-flex">
        <svg
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <span>v1.0.0</span>
      </span>

      {/* Current time - always shown (even on mobile) */}
      <span
        class="flex items-center gap-1 font-mono text-accent/70"
        data-current-time
      >
        <svg
          class="hidden h-3 w-3 sm:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="time-display">--:--:--</span>
      </span>

      {/* Prompt symbol */}
      <span class="prompt-symbol ml-1 hidden text-foreground/30 sm:inline"
        >$</span
      >
    </div>
  </div>
</nav>

<script>
  // Update current time
  function updateTime() {
    const timeElements = document.querySelectorAll(
      "[data-current-time] .time-display"
    );
    const now = new Date();
    const timeString = now.toLocaleTimeString("en-US", {
      hour12: false,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
    });
    timeElements.forEach(el => {
      el.textContent = timeString;
    });
  }

  // Initialize
  updateTime();
  setInterval(updateTime, 1000);
</script>

<style>
  .breadcrumb-bar {
    -webkit-backdrop-filter: blur(4px);
  }

  .breadcrumb-current {
    max-width: 40vw;
  }

  @media (max-width: 640px) {
    .breadcrumb-current {
      max-width: 50vw;
    }
  }
</style>
